# .env.example - Plantilla de variables de entorno

# Base de datos MySQL
# Formato: mysql://usuario:contraseña@host:puerto/nombre_base_datos
DATABASE_URL="mysql://root:password@localhost:3306/time_report"

# JWT Secret para autenticación (cambiar en producción, mínimo 32 caracteres)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production-min-32-chars"

# Supabase (opcional - solo si usas autenticación con Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui
